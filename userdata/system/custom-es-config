#!/bin/bash
# 15kHz interlaced (480i) mode for the CRT on DP-3 via VGA->SCART.
#
# Requires the patched i915 installed by /boot/boot-custom.sh: stock i915
# advertises Y-tiled scanout modifiers, and the display engine refuses Y-tiled
# scanout in IF-ID interlace mode, so interlaced modesets failed with -EINVAL
# ('xrandr: Configure crtc 0 failed').
#
# Timings are switchres' generic_15 720x480 entry - the same family the
# per-game SR-1_* modes are generated from - so the raster lands in the same
# place in the menu as it does in game, and one TV geometry calibration covers
# both. A hand-tuned modeline here would run at a slightly different
# horizontal frequency and shift the picture between menu and game.
#
# The mode is deliberately named after its real resolution and carries no 'i':
# batocera-resolution parses mode names as WxH and runs numeric tests on the
# halves, so anything non-numeric throws '[: Illegal number'.
LOG="/userdata/system/logs/crt-mode.log"
MODE="720x454"

echo "$(date): applying CRT mode $MODE" >> "$LOG"
xrandr --query | grep -q "$MODE" || \
    xrandr --newmode "$MODE" 14.727 720 748 817 936 454 470 476 525 -hsync -vsync interlace >>"$LOG" 2>&1
xrandr --addmode DP-3 "$MODE" >>"$LOG" 2>&1
xrandr --output DP-3 --mode "$MODE" >>"$LOG" 2>&1

# emulationstation-standalone backgrounds this script and then runs
# 'xrandr --auto' while starting ES, which snaps the output back to a probed
# mode, so keep re-asserting until it sticks for a few checks in a row.
# Bounded on purpose: once ES is up we stop, so RetroArch's own per-game CRT
# switching is not fought over.
stable=0
for i in $(seq 1 30); do
    sleep 2
    if xrandr --query | grep -q "$MODE.*\*"; then
        stable=$((stable + 1))
        [ "$stable" -ge 3 ] && { echo "$(date): $MODE stable" >> "$LOG"; break; }
    else
        stable=0
        echo "$(date): mode drifted, re-applying (try $i)" >> "$LOG"
        xrandr --output DP-3 --mode "$MODE" >>"$LOG" 2>&1
    fi
done
